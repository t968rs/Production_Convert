{
  "debug_override_rel": "scripts/fpm/__init__.py",
  "global_denied": [
    "__pycache__", "*.pyc", "*.pyi", "*.pyo", "*.bak",
    ".git", ".github", ".vscode", ".idea",
    ".mypy_cache", ".pytest_cache", ".ruff_cache", ".coverage", "*.egg-info",
    "*.db", "*.sqlite", "*.dev.env"
  ],
  "top_level_files": ["README.md", "CHANGELOG.md", "LICENSE", "*.atbx"],
  "folders": [
    {
      "name": "scripts",
      "required": true,
      "allowed": ["fpm/**"],
      "denied": ["fpm/_tbx_staging/**", "fpm/ref_mgmt/cache/**", "fpm/grids/raster_specs/cache/**"]
    },
    { "name": "calcs", "required": true, "allowed": [], "denied": ["working/**"] },
    {
      "name": "reference",
      "required": false,
      "allowed": [],
      "denied": ["reference_modules/**", "toolbox_figures/**",
                 "env/**", "db/**", "git_curated/**", "esri_docs/**",
                 "field_maps/gdb_schemas/**", "esriCRS/_runtime_cache.json"]
    },
    { "name": "tool_metadata", "required": false, "allowed": ["tool_help/*.html", "tool_help/img/**"], "denied": ["tool_help/_fragments/**", "tool_help/_template.html"] }
  ]
}
